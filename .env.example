# The site's own origin, no trailing slash. Used for canonical links, Open Graph
# URLs, the sitemap and robots.txt. Falls back to Vercel's production URL, then
# to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Sanity project — copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01

# Server-only. A Viewer token from sanity.io/manage → API → Tokens. Draft mode
# reads unpublished content with it; without it, /api/draft still works but shows
# published content.
SANITY_API_READ_TOKEN=

# Server-only. One secret, used twice: Sanity signs the revalidation webhook with
# it, and /api/draft?secret=... checks it before starting a preview.
SANITY_REVALIDATE_SECRET=
