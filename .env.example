# Sanity project — copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01

# Server-only. Read token used by draft mode (Phase 9).
SANITY_API_READ_TOKEN=

# Server-only. Shared secret that signs the Sanity revalidation webhook (Phase 9).
SANITY_REVALIDATE_SECRET=
